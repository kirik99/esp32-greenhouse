// ============================================================
//  ЭТАП 1 — Проверка ESP32
//  Проект: Автоматизация теплицы
//  Дата:   2026-08
// ============================================================
//
//  Что делает программа:
//  1. Запускает ESP32
//  2. Выводит приветственное сообщение в Serial Monitor
//  3. Каждые 2 секунды пишет "ESP32 работает"
//
// ============================================================

void setup() {
  // Запускаем Serial Monitor со скоростью 115200 baud
  Serial.begin(115200);

  // Небольшая пауза — даём время Serial Monitor подключиться
  delay(1000);

  // Выводим приветствие
  Serial.println("========================================");
  Serial.println("  Теплица ESP32 - СТАРТ");
  Serial.println("  Этап 1: Проверка работы платы");
  Serial.println("========================================");
  Serial.println("  ESP32 успешно запущен!");
  Serial.println("  Скорость Serial: 115200 baud");
  Serial.println("========================================");
}

void loop() {
  // Каждые 2 секунды выводим сообщение
  Serial.println("ESP32 работает");
  delay(2000);
}
