# ==========================================
# Growbox IoT Server Configuration
# ==========================================

# Timezone (e.g. Europe/Moscow, UTC, America/New_York)
TZ=Europe/Moscow

# Security & Dashboard Access PIN
# Checked securely on the server with timing-safe comparison and brute-force protection (max 5 attempts, 15m lockout)
ADMIN_PIN=2212

# Telemetry Access: false = requires PIN to view camera, sensor history, and live telemetry
# true = public read-only telemetry, PIN only needed for relay switches and stage selection
PUBLIC_TELEMETRY=false

# InfluxDB 2.x Settings
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change_this_to_a_secure_password
INFLUXDB_ORG=growbox
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=generate_a_secure_random_token_here

# MQTT Broker Authentication (Single source of truth for Mosquitto and Bridge)
# Generated dynamically into /mosquitto/data/passwords.txt on startup
MQTT_ESP32_USER=growbox_esp32
MQTT_ESP32_PASSWORD=change_this_esp32_secret

MQTT_BRIDGE_USER=growbox_bridge
MQTT_BRIDGE_PASSWORD=change_this_bridge_secret

# Web UI MQTT Client (Delivered securely to browser over HTTPS upon valid PIN login)
MQTT_WEB_USER=growbox_web
MQTT_WEB_PASSWORD=change_this_web_secret

# Service Ports (Local host bindings)
WEB_PORT=80
SSL_PORT=443
MQTT_PORT=1883
INFLUXDB_PORT=8086
