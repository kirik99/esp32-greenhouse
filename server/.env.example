# ==========================================
# Growbox IoT Server Configuration
# ==========================================

# Timezone (e.g. Europe/Moscow, UTC, America/New_York)
TZ=Europe/Moscow

# InfluxDB 2.x Settings
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=growbox
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=growbox-super-secret-token

# Service Ports (defaults: Web 80, MQTT 1883, InfluxDB 8086)
WEB_PORT=80
MQTT_PORT=1883
INFLUXDB_PORT=8086
