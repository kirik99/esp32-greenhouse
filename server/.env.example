# ==========================================
# Growbox IoT Server Configuration
# ==========================================

# Timezone (e.g. Europe/Moscow, UTC, America/New_York)
TZ=Europe/Moscow

# Security & Dashboard Access PIN
# This PIN is checked server-side and never exposed to client or Git
ADMIN_PIN=2212

# InfluxDB 2.x Settings
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=your_secure_password_here
INFLUXDB_ORG=growbox
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=your_secure_influx_token_here

# Service Ports
WEB_PORT=80
SSL_PORT=443
MQTT_PORT=1883
INFLUXDB_PORT=8086
